# OCAPI - Configuration Example
# Copiez ce fichier vers .env et remplissez vos valeurs

# ============================================================================
# LLM API Configuration
# ============================================================================

# PIAG API (API du Ministère de la Transition Écologique)
# Obtenir une clé : https://piag.e2.rie.gouv.fr
PIAG_API_KEY=

# URL de l'API PIAG (défaut: preprod)
# Production: https://api.piag.e2.rie.gouv.fr/v1/chat/completions
# Preprod (défaut): https://preprod.api.piag.e2.rie.gouv.fr/v1/chat/completions
#PIAG_API_URL=https://preprod.api.piag.e2.rie.gouv.fr/v1/chat/completions

# OpenAI API (optionnel, alternative à PIAG)
OPENAI_API_KEY=

# URL de l'API OpenAI (défaut: https://api.openai.com/v1/chat/completions)
#OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# ============================================================================
# Pipeline Configuration
# ============================================================================

# Modèle LLM par défaut
# Options PIAG: mte-api-piag-mistral-medium-latest, mte-api-piag-mistral-large-latest
# Options OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
#PIPELINE__DEFAULT_LLM_MODEL=mte-api-piag-mistral-medium-latest

# Placeholder pour indiquer au LLM d'insérer la section complète
#PIPELINE__FULL_SECTION=contenu entier

# Nombre maximum de tentatives pour les appels LLM (0-10)
#PIPELINE__MAX_RETRIES=3

# Timeout en secondes pour les appels LLM (1-600)
#PIPELINE__TIMEOUT=120

# ============================================================================
# Paths Configuration (Avancé)
# ============================================================================

# Racine du projet (auto-détecté si non spécifié)
#PROJECT_ROOT=/path/to/ocapi

# Chemin vers le catalogue des arrêtés
#CATALOGUE_PATH=/path/to/catalogue_ap.json

# ============================================================================
# Logging Configuration
# ============================================================================

# Niveau de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Défaut: INFO
#LOG__LEVEL=INFO

# Fichier de log (laisser vide pour désactiver le logging fichier)
# Défaut: None (pas de fichier)
# Exemple: logs/ocapi.log
#LOG__LOG_FILE=logs/ocapi.log

# Taille maximale d'un fichier de log avant rotation (en octets)
# Défaut: 1048576 (1024 KB)
#LOG__MAX_BYTES=1048576

# Nombre de fichiers de backup à conserver
# Défaut: 5
#LOG__BACKUP_COUNT=5

# Activer la rotation quotidienne (true/false)
# Défaut: true
#LOG__USE_TIMED_ROTATION=true

# Afficher les logs dans la console (true/false)
# Défaut: true
#LOG__CONSOLE_OUTPUT=true