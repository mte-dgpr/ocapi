# =============================================================================
# OCAPI - Configuration des variables d'environnement
# =============================================================================
# Copiez ce fichier en .env et renseignez les valeurs appropriées.
# Les variables sans valeur par défaut sont OBLIGATOIRES si vous utilisez
# le provider correspondant.
# =============================================================================

# === LLM Configuration ===

# --- PIAG API (défaut pour le MTE) ---
# Clé d'API PIAG - OBLIGATOIRE si vous utilisez le modèle PIAG (défaut)
PIAG_API_KEY=

# URL de l'API PIAG (optionnel, valeur par défaut ci-dessous)
PIAG_API_URL=https://preprod.api.piag.e2.rie.gouv.fr/v1/chat/completions

# --- OpenAI API (optionnel) ---
# Clé d'API OpenAI - OBLIGATOIRE uniquement si vous utilisez GPT5 ou GPT5mini
OPENAI_API_KEY=

# URL de l'API OpenAI (optionnel, valeur par défaut ci-dessous)
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# === Pipeline Configuration ===

# Modèle LLM par défaut utilisé dans le pipeline
# Valeurs possibles: mte-api-piag-mistral-medium-latest, GPT5, GPT5mini
DEFAULT_LLM_MODEL=mte-api-piag-mistral-medium-latest

# Placeholder pour indiquer au LLM d'insérer la section complète
FULL_SECTION=contenu entier

# === Paths Configuration ===

# Racine du projet (optionnel, auto-détecté par défaut)
# PROJECT_ROOT=/chemin/vers/ocapi

# Chemin vers le catalogue des arrêtés (optionnel)
# CATALOGUE_PATH=/chemin/vers/catalogue_ap.json
