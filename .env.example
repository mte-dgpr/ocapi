# Configuration OCAPI
# Copiez ce fichier vers .env et remplissez vos valeurs

# =============================================================================
# Configuration LLM
# =============================================================================

# PIAG API (defaut pour le MTE)
LLM__PIAG_API_KEY=
LLM__PIAG_API_URL=https://preprod.api.piag.din.gouv.fr/v1/chat/completions

# Mistral API (optionnel)
LLM__MISTRAL_API_KEY=
LLM__MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# OpenAI API (optionnel)
LLM__OPENAI_API_KEY=
LLM__OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# =============================================================================
# Configuration Pipeline
# =============================================================================

# Placeholder pour indiquer l'insertion de section complete
# PIPELINE__FULL_SECTION=contenu entier

# =============================================================================
# Configuration Chemins
# =============================================================================

# Racine du projet (par defaut : repertoire parent du package ocapi)
# PATHS__PROJECT_ROOT=/chemin/vers/le/projet

# Chemin vers le catalogue des arretes
# PATHS__CATALOGUE_PATH=/chemin/vers/catalogue_ap.json

# =============================================================================
# Configuration Logging
# =============================================================================

# Niveau de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOGGING__LEVEL=INFO

# Fichier de log (laisser vide pour desactiver)
# LOGGING__LOG_FILE=logs/ocapi.log

# Afficher les logs dans la console (true/false)
# LOGGING__CONSOLE_OUTPUT=true

# Taille maximale du fichier de log en octets (0 = pas de rotation)
# LOGGING__MAX_BYTES=10485760

# Nombre de fichiers de backup a conserver
# LOGGING__BACKUP_COUNT=5

# Utiliser la rotation temporelle au lieu de la taille (true/false)
# LOGGING__USE_TIMED_ROTATION=false
